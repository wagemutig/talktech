---
// Landing page for readers of the Zürcher Schulblatt (article QR code / link points here).
// Update XARA_URL and VALID_UNTIL when the team issues a new demo link.
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const XARA_URL = 'https://training.xaraapp.ch/?token=qKAlqnRo07XdQYEm9OsFNp6sY4X4KFyAAeulm3HMjcKvWpTKofbkZxS6sK9KBZ3qea67_vHTWxN_Zy-Q0-WnWA&valid_until=31-01-2027';
const VALID_UNTIL = '2027-01-31'; // last day the demo link works
const validLabel = '31. Januar 2027';

// The worksheet button appears automatically once the PDF is in public/
const WORKSHEET = 'arbeitsblatt-mr-barker-visits.pdf';
const hasWorksheet = fs.existsSync(new URL(`../../public/${WORKSHEET}`, import.meta.url));
---
<Layout title="Mr. Barker visits ausprobieren · TALK-TECH">
  <nav class="nav" aria-label="Hauptnavigation">
    <div class="wrap">
      <a class="wordmark" href={`${b}/`}>TALK-TECH</a>
      <div class="nav-links">
        <a href="#start">Ausprobieren</a>
        <a href="#ablauf">Ablauf</a>
        <a href="#lehrpersonen">Für Lehrpersonen</a>
      </div>
      <a class="btn btn-primary" href={`${b}/#kontakt`}>Kontakt</a>
    </div>
  </nav>

  <header class="sb-hero" id="start">
    <div class="wrap sb-hero-grid">
      <div>
        <p class="eyebrow">Zürcher Schulblatt · TALK-TECH</p>
        <h1>Probieren Sie Mr.&nbsp;Barker selbst aus.</h1>
        <p class="lede">Im Zürcher Schulblatt haben Sie von TALK-TECH gelesen. Hier testen Sie die KI-Gesprächssimulation selbst: Sie erklären einem US-amerikanischen Geschäftspartner eine technische Baugruppe, auf Englisch und in Echtzeit.</p>

        <div class="sb-cta" data-valid-until={VALID_UNTIL}>
          <div class="sb-live">
            <div class="cta">
              <a class="btn btn-primary" href={XARA_URL} target="_blank" rel="noopener">Simulation starten →</a>
              {hasWorksheet && <a class="btn btn-ghost" href={`${b}/${WORKSHEET}`} download>Arbeitsblatt (PDF)</a>}
            </div>
            <p class="sb-meta">Im Browser, ohne Installation · ca. 15 Minuten · verfügbar bis {validLabel}</p>
            <p class="sb-meta">Es werden keine persönlichen Daten übermittelt oder gespeichert.</p>
          </div>
          <div class="sb-ended" hidden>
            <p><b>Die öffentliche Demo ist beendet.</b> Möchten Sie Mr. Barker mit Ihrer Klasse ausprobieren? Wir zeigen Ihnen die Simulation gerne persönlich.</p>
            <div class="cta"><a class="btn btn-primary" href={`${b}/#kontakt`}>Vorführung anfragen →</a></div>
          </div>
        </div>
      </div>

      <aside class="sb-check" aria-labelledby="check-h">
        <h2 id="check-h">Bevor Sie starten</h2>
        <ul>
          <li><span>01</span>Laptop oder Desktop mit Chrome oder Edge. Ein Smartphone geht auch.</li>
          <li><span>02</span>Kopfhörer oder Headset mit Mikrofon.</li>
          <li><span>03</span>Ein ruhiger Raum. Die Spracherkennung reagiert auf Hintergrundgeräusche.</li>
          <li><span>04</span>Den Mikrofonzugriff erlauben, wenn der Browser danach fragt.</li>
          <li><span>05</span>Das Arbeitsblatt mit der technischen Zeichnung bereithalten.</li>
        </ul>
      </aside>
    </div>
  </header>

  <section id="ablauf">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Ablauf</p>
        <h2>Drei Phasen, rund 15 Minuten.</h2>
        <p>Zwei KI-Figuren begleiten Sie: Ms. Goodwill bereitet vor und gibt Feedback, Mr. Barker stellt die Fragen.</p>
      </div>
      <div class="phases">
        <div class="phase">
          <div class="top"><span class="num">01</span><span>~2 Min. · Deutsch</span></div>
          <h3>Briefing</h3>
          <p>Ms. Goodwill führt auf Deutsch ins Szenario und den Fachwortschatz ein.</p>
          <div class="agent"><img src={`${b}/images/avatar_msgoodwill.png`} alt="">Ms. Goodwill · Mentorin</div>
        </div>
        <div class="phase">
          <div class="top"><span class="num">02</span><span>~10 Min. · Englisch</span></div>
          <h3>Fachgespräch</h3>
          <p>Zehn Fragen von Mr. Barker. Er passt das Niveau Ihren Antworten an, vom Benennen der Teile bis zur Fehlersuche.</p>
          <div class="agent"><img src={`${b}/images/avatar_mrbarker.png`} alt="">Mr. Barker · Kunde</div>
        </div>
        <div class="phase">
          <div class="top"><span class="num">03</span><span>~3 Min. · zweisprachig</span></div>
          <h3>Reflexion</h3>
          <p>Ms. Goodwill wertet das Gespräch aus und gibt Feedback zu Wortschatz, Grammatik und Flüssigkeit.</p>
          <div class="agent"><img src={`${b}/images/avatar_msgoodwill.png`} alt="">Ms. Goodwill · Coach</div>
        </div>
      </div>
    </div>
  </section>

  <section id="lehrpersonen">
    <div class="wrap sb-teachers">
      <div>
        <p class="eyebrow">Für Lehrpersonen</p>
        <h2>Mit der ganzen Klasse gleichzeitig.</h2>
        <p>In der Klasse führt jede lernende Person ihr eigenes Gespräch, alle 24 parallel. Die Simulation ist für Polymechaniker:innen und Automatiker:innen im Rahmen von FutureMEM entwickelt. Im Klassenpilot an der Berufsschule Rüti erreichte sie einen SUS-Score von 74,3, der Benchmark liegt bei 68.</p>
        <div class="cta">
          <a class="btn btn-primary" href={`${b}/#kontakt`}>Klassendemo anfragen →</a>
          <a class="btn btn-ghost" href={`${b}/#mr-barker`}>Mehr über die Simulation</a>
        </div>
      </div>
      <dl class="sb-facts">
        <div><dt>Zielgruppe</dt><dd>Polymechanik, Automatik, MEM-Berufe</dd></div>
        <div><dt>Sprachniveau</dt><dd>Englisch B2</dd></div>
        <div><dt>Dauer</dt><dd>ca. 15 Min. pro Person</dd></div>
        <div><dt>Geräte</dt><dd>Browser, Smartphone, VR-Brille</dd></div>
      </dl>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <a class="wordmark" href={`${b}/`}>TALK-TECH</a>
      <span>KI-Gesprächssimulationen für die Berufsbildung</span>
    </div>
  </footer>

  <script is:inline>
    // Swap the start button for a contact prompt once the demo link has expired
    (function(){
      var box=document.querySelector('.sb-cta'); if(!box) return;
      var end=new Date(box.getAttribute('data-valid-until')+'T23:59:59+01:00');
      if(Date.now()>end.getTime()){
        box.querySelector('.sb-live').hidden=true;
        box.querySelector('.sb-ended').hidden=false;
      }
    })();
  </script>
</Layout>

<style>
  .sb-hero{border-bottom:1px solid var(--line)}
  .sb-hero-grid{display:grid;grid-template-columns:7fr 5fr;gap:clamp(28px,5vw,64px);padding-block:clamp(40px,6vw,72px);align-items:start}
  @media (max-width:860px){.sb-hero-grid{grid-template-columns:1fr}}
  .sb-hero h1{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:850;font-stretch:88%;letter-spacing:-.02em;margin-top:var(--s-eyebrow)}
  .sb-meta{margin-top:10px;font-size:.88rem;color:var(--muted)}
  .sb-ended{margin-top:28px;padding:20px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
  .sb-ended p{max-width:52ch}
  .sb-check{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:clamp(20px,3vw,28px)}
  .sb-check h2{font-size:1.3rem;font-weight:800}
  .sb-check ul{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:12px}
  .sb-check li{display:grid;grid-template-columns:28px 1fr;gap:8px;font-size:.95rem}
  .sb-check li span{font:600 .78rem/1.7 var(--mono);color:var(--muted)}
  .sb-teachers{display:grid;grid-template-columns:7fr 5fr;gap:clamp(28px,5vw,64px);align-items:start}
  @media (max-width:860px){.sb-teachers{grid-template-columns:1fr}}
  .sb-teachers h2{font-size:clamp(1.9rem,3.4vw,2.8rem);font-weight:800;font-stretch:90%;margin:var(--s-eyebrow) 0 16px}
  .sb-teachers p{color:var(--muted);max-width:60ch}
  .sb-facts{margin:0;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
  .sb-facts div{display:grid;grid-template-columns:120px 1fr;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line)}
  .sb-facts div:last-child{border-bottom:0}
  .sb-facts dt{font:500 .72rem/1.6 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .sb-facts dd{margin:0}
  section:last-of-type{padding-bottom:var(--s-sec)}
</style>
